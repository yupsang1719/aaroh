# Production settings for the VPS. Lives at /etc/aaroh/aaroh.env (root-owned, readable by the
# aaroh group only). After editing: systemctl restart aaroh
NODE_ENV=production
HOST=127.0.0.1
PORT=4100
SITE_URL=https://aaroh.co.uk
# nginx sits in front of the app.
TRUST_PROXY=1

# Only needed once the contact form is switched on (settings.json › contactFormEnabled).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=
# SMTP_FROM=Aaroh website <website@aaroh.co.uk>
# CONTACT_NOTIFY_TO=rlp@aaroh.co.uk
