# Copy to client/.env if you need to override anything. Never commit the real .env.

# Public URL of the site, used for canonical URLs and JSON-LD in the browser.
VITE_SITE_URL=https://aaroh.co.uk

# API base. Leave empty: the client always calls its own origin (/api), which Vite
# proxies to Express in development and Express serves directly in production.
VITE_API_BASE=
