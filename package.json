{
  "name": "aaroh",
  "private": true,
  "version": "0.1.0",
  "description": "Website for Aaroh, an independent music company.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n db,server,client -c gray,blue,magenta \"npm:dev:db -w server\" \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "test": "npm run test -w server -w client --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck -w shared -w server -w client",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "type": "module"
}
