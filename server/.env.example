# Copy to server/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Public URL of the site: used for canonical URLs, OG images, sitemap and JSON-LD.
SITE_URL=https://aaroh.co.uk

# Where content comes from. Only "mongo" is implemented for now.
CONTENT_SOURCE=mongo

# Local: docker compose up -d mongo. Production: your MongoDB Atlas connection string.
MONGODB_URI=mongodb://localhost:27017/aaroh

# Browser origin allowed by CORS (the Vite dev server in development).
CLIENT_ORIGIN=http://localhost:5173

# Secret salt for hashing contact-form IP addresses. Use a long random string in production.
IP_HASH_SALT=change-me

# Optional: email notifications for contact messages. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Aaroh website <no-reply@aaroh.co.uk>"
# PLACEHOLDER until confirmed
CONTACT_NOTIFY_TO=hello@aaroh.co.uk
