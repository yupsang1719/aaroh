# Copy to server/.env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Public URL of the site: used for canonical URLs, share images, sitemap and structured data.
SITE_URL=https://aaroh.co.uk

# Content comes from JSON files: settings.json, releases.json and media/ in this folder.
# Defaults to server/content. `npm run dev:sample` uses server/content-sample instead.
# CONTENT_DIR=

# Browser origin(s) allowed by CORS, comma-separated (the Vite dev server in development).
CLIENT_ORIGIN=http://localhost:5173

# Proxies in front of the app. Set to 1 on Render/Railway so rate limiting sees real client IPs.
TRUST_PROXY=0

# Production only: where the built client is. Defaults to ../client/dist; rarely needs setting.
# CLIENT_DIST_DIR=

# Contact form rate limit per IP.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_MINUTES=15

# Contact form email delivery (SMTP). Only needed once the contact form is switched on
# (server/content/settings.json › contactFormEnabled); then production will not start without
# SMTP_HOST, SMTP_USER and SMTP_PASS. In development, leave SMTP_HOST empty and
# messages are printed in the terminal instead. Test the settings with `npm run email:test`.
# Recommended: Resend (see README), i.e. SMTP_HOST=smtp.resend.com, SMTP_USER=resend,
# SMTP_PASS=<Resend API key>. Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# An address the SMTP service may send as (any address on your Resend-verified domain).
SMTP_FROM="Aaroh website <website@aaroh.co.uk>"
# Inbox that receives contact form messages.
CONTACT_NOTIFY_TO=rlp@aaroh.co.uk
